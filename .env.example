# Copy this file to ".env" and fill in the values.

# PostgreSQL connection string.
# Production: Neon (choose the Singapore region), use the direct (non-pooled) URL.
# Local: run `npx prisma dev --name cml --detach`, take the TCP URL from
# `npx prisma dev ls` and append `&pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Random secret used to sign admin sessions. Generate one with: npx auth secret
AUTH_SECRET=""

# Public URL of the site, used in password-reset emails and SEO metadata.
SITE_URL="https://colormylifebd.com"

# Initial admin account, created by `npm run db:seed`.
# If ADMIN_PASSWORD is empty, a random password is generated and printed once.
ADMIN_EMAIL="emon.artist.yt@gmail.com"
ADMIN_PASSWORD=""

# Cloudinary stores product photos uploaded from /admin (required on Vercel).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend sends password-reset emails (required in production).
# EMAIL_FROM must use a domain verified in Resend, e.g. "Color My Life <no-reply@colormylifebd.com>".
RESEND_API_KEY=""
EMAIL_FROM=""
